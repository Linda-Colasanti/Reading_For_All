<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Professor's AI Playbook — Linda Colasanti</title>

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Reading For All™" />
  <meta property="og:title" content="The Professor's AI Playbook" />
  <meta property="og:description" content="A Practitioner's Framework for Higher Ed Leaders. Stop fighting AI. Start using it better than your students do." />
  <meta property="og:url" content="https://lessons.readingforall.com/professors-4w9m" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="The Professor's AI Playbook" />
  <meta name="twitter:description" content="Stop fighting AI. Start using it better than your students do." />

  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />

  <style>
    :root {
      --navy:   #0d1b3e;
      --navy2:  #0a1530;
      --gold:   #f5c842;
      --gold2:  #e8a820;
      --white:  #fffef9;
      --red:    #e84040;
      --orange: #f97316;
      --yellow: #f5c842;
      --green:  #22c55e;
      --blue:   #3b82f6;
      --indigo: #6366f1;
      --violet: #a855f7;
      --teal:   #14b8a6;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Nunito', sans-serif;
      background: var(--navy);
      color: var(--white);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── RAINBOW BAR ── */
    .rainbow-bar {
      height: 6px;
      background: linear-gradient(90deg,
        var(--red) 0%, var(--orange) 16%, var(--yellow) 32%,
        var(--green) 48%, var(--blue) 64%, var(--indigo) 80%, var(--violet) 100%);
    }

    /* ── HERO ── */
    .hero {
      position: relative;
      padding: 3.5rem 2rem 3rem;
      text-align: left;
      overflow: hidden;
      min-height: 480px;
      display: flex;
      align-items: center;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse at 0% 50%, #1a2f6e 0%, transparent 60%),
        radial-gradient(ellipse at 100% 0%, #0f1f55 0%, transparent 50%),
        radial-gradient(ellipse at 50% 100%, #06112b 0%, transparent 60%),
        linear-gradient(135deg, #0d1b3e 0%, #0c1a4a 40%, #0a1535 100%);
      z-index: 0;
    }

    .floating-letters {
      position: absolute;
      inset: 0;
      overflow: hidden;
      z-index: 1;
      pointer-events: none;
    }

    .fl {
      position: absolute;
      font-family: 'Playfair Display', serif;
      font-weight: 900;
      color: rgba(245,200,66,0.06);
      user-select: none;
      animation: floatUp linear infinite;
    }

    @keyframes floatUp {
      0%   { transform: translateY(110%) rotate(-10deg); opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { transform: translateY(-110%) rotate(10deg); opacity: 0; }
    }

    .hero-photo {
      position: absolute;
      right: 0;
      bottom: 0;
      height: 110%;
      max-width: 50%;
      object-fit: contain;
      object-position: bottom right;
      z-index: 2;
      opacity: 0.18;
      mix-blend-mode: luminosity;
      mask-image: linear-gradient(to left, rgba(0,0,0,0.7) 40%, transparent 100%);
      -webkit-mask-image: linear-gradient(to left, rgba(0,0,0,0.7) 40%, transparent 100%);
      filter: contrast(1.1) brightness(1.2);
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to right,
        rgba(13,27,62,0.95) 0%,
        rgba(13,27,62,0.7) 45%,
        rgba(13,27,62,0.1) 100%);
      z-index: 3;
    }

    .hero-content {
      position: relative;
      z-index: 4;
      max-width: 580px;
    }

    .brand-tag {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      border: 1.5px solid rgba(245,200,66,0.4);
      border-radius: 999px;
      padding: 0.3rem 1rem;
      margin-bottom: 1.2rem;
      opacity: 0;
      animation: fadeUp 0.6s ease forwards 0.1s;
    }

    .hero-row {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      margin-bottom: 0.6rem;
    }

    .hero-icon {
      font-size: clamp(4rem, 12vw, 7rem);
      line-height: 1;
      filter: drop-shadow(0 0 30px rgba(245,200,66,0.4));
      opacity: 0;
      animation: fadeUp 0.7s ease forwards 0.2s;
    }

    .hero-title-block {
      opacity: 0;
      animation: fadeUp 0.7s ease forwards 0.3s;
    }

    .hero-title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(1.6rem, 4vw, 2.8rem);
      font-weight: 700;
      color: var(--white);
      line-height: 1.1;
    }

    .hero-subtitle {
      font-size: 0.95rem;
      color: rgba(255,255,255,0.55);
      font-weight: 600;
      margin-top: 0.3rem;
    }

    .hero-hook {
      font-size: 1rem;
      color: var(--gold);
      font-weight: 800;
      margin-top: 0.5rem;
      letter-spacing: 0.01em;
    }

    .hero-description {
      font-size: 1rem;
      color: rgba(255,255,255,0.75);
      line-height: 1.65;
      margin-top: 1rem;
      max-width: 460px;
      opacity: 0;
      animation: fadeUp 0.7s ease forwards 0.45s;
    }

    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.4rem;
      opacity: 0;
      animation: fadeUp 0.7s ease forwards 0.6s;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border-radius: 999px;
      padding: 0.6rem 1.3rem;
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.02em;
      transition: all 0.2s ease;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
      border: none;
      text-decoration: none;
      cursor: pointer;
    }

    .badge:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.4); }

    .avatar-guide {
      position: absolute;
      bottom: -20px;
      right: 2rem;
      z-index: 5;
      width: 130px;
      height: 130px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid var(--gold);
      box-shadow: 0 0 0 6px rgba(245,200,66,0.15), 0 20px 40px rgba(0,0,0,0.4);
      opacity: 0;
      animation: fadeUp 0.8s ease forwards 0.8s;
    }

    .avatar-guide img { width: 100%; height: 100%; object-fit: cover; }

    .avatar-label {
      position: absolute;
      bottom: -52px;
      right: 2rem;
      z-index: 5;
      text-align: center;
      width: 130px;
      font-size: 0.72rem;
      font-weight: 800;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      opacity: 0;
      animation: fadeUp 0.8s ease forwards 0.9s;
    }

    /* ── LEARN STRIP ── */
    .learn-section {
      background: rgba(255,255,255,0.04);
      border-top: 1px solid rgba(255,255,255,0.07);
      border-bottom: 1px solid rgba(255,255,255,0.07);
      padding: 1.8rem 2rem;
      margin-top: 3rem;
    }

    .learn-inner {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
    }

    .learn-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.88rem;
      font-weight: 700;
      color: rgba(255,255,255,0.8);
    }

    .learn-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    /* ── INSTRUCTION BANNER ── */
    .instruction-banner {
      background: linear-gradient(135deg, rgba(245,200,66,0.12), rgba(245,200,66,0.06));
      border-top: 1px solid rgba(245,200,66,0.2);
      border-bottom: 1px solid rgba(245,200,66,0.2);
      padding: 1rem 2rem;
    }

    .instruction-inner {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .instruction-icon { font-size: 1.5rem; flex-shrink: 0; }

    .instruction-text {
      font-size: 0.88rem;
      color: rgba(255,255,255,0.85);
      line-height: 1.6;
      font-weight: 600;
    }

    .instruction-text strong { color: var(--gold); }

    /* ── MAIN ── */
    .main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 3rem 1.5rem;
      display: grid;
      gap: 2rem;
    }

    /* ── CARDS ── */
    .card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 20px;
      overflow: hidden;
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
      opacity: 0;
      animation: fadeUp 0.6s ease forwards;
    }

    .card:hover {
      transform: translateY(-4px);
      border-color: rgba(245,200,66,0.3);
      box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }

    .card:nth-child(1) { animation-delay: 0.1s; }
    .card:nth-child(2) { animation-delay: 0.2s; }
    .card:nth-child(3) { animation-delay: 0.3s; }
    .card:nth-child(4) { animation-delay: 0.4s; }
    .card:nth-child(5) { animation-delay: 0.5s; }
    .card:nth-child(6) { animation-delay: 0.6s; }
    .card:nth-child(7) { animation-delay: 0.7s; }
    .card:nth-child(8) { animation-delay: 0.8s; }

    /* ── CARD BANNERS ── */
    .card-banner {
      position: relative;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.4rem 1.8rem;
      overflow: hidden;
    }

    .banner-step {
      font-size: 0.7rem;
      font-weight: 900;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      opacity: 0.8;
      position: absolute;
      top: 0.6rem;
      left: 1.8rem;
    }

    .banner-icon {
      font-size: 2.2rem;
      flex-shrink: 0;
      margin-top: 0.6rem;
      filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
    }

    .banner-text { flex: 1; margin-top: 0.6rem; }

    .banner-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.6rem;
      font-weight: 900;
      color: #fff;
      line-height: 1;
      text-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .banner-sub {
      font-size: 0.82rem;
      font-weight: 700;
      color: rgba(255,255,255,0.75);
      margin-top: 0.2rem;
      letter-spacing: 0.03em;
    }

    .banner-number {
      font-family: 'Playfair Display', serif;
      font-size: 5rem;
      font-weight: 900;
      color: rgba(255,255,255,0.1);
      line-height: 1;
      position: absolute;
      right: 1.2rem;
      bottom: -0.5rem;
      pointer-events: none;
      user-select: none;
    }

    .banner-red    { background: linear-gradient(135deg, #c0392b 0%, #e84040 50%, #ff6b6b 100%); }
    .banner-blue   { background: linear-gradient(135deg, #1a56db 0%, #3b82f6 50%, #60a5fa 100%); }
    .banner-green  { background: linear-gradient(135deg, #15803d 0%, #22c55e 50%, #4ade80 100%); }
    .banner-violet { background: linear-gradient(135deg, #7c3aed 0%, #a855f7 50%, #c084fc 100%); }
    .banner-gold   { background: linear-gradient(135deg, #b45309 0%, #d97706 50%, #f5c842 100%); }
    .banner-teal   { background: linear-gradient(135deg, #0f766e 0%, #14b8a6 50%, #2dd4bf 100%); }
    .banner-pink   { background: linear-gradient(135deg, #be185d 0%, #ec4899 50%, #f472b6 100%); }
    .banner-navy   { background: linear-gradient(135deg, #0d1b3e 0%, #1a2f6e 50%, #0f2060 100%); border-bottom: 2px solid rgba(245,200,66,0.4); }

    /* ── CARD BODY ── */
    .card-body {
      padding: 1.8rem;
    }

    .card-body p {
      font-size: 0.95rem;
      color: rgba(255,255,255,0.78);
      line-height: 1.7;
      margin-bottom: 1rem;
    }

    .card-body p:last-child { margin-bottom: 0; }

    .card-body strong { color: var(--gold); }

    /* ── CALLOUT BOX ── */
    .callout {
      background: linear-gradient(135deg, rgba(245,200,66,0.1), rgba(245,200,66,0.05));
      border-left: 4px solid var(--gold);
      border-radius: 0 12px 12px 0;
      padding: 1rem 1.4rem;
      margin: 1.2rem 0;
      font-size: 0.95rem;
      color: rgba(255,255,255,0.85);
      line-height: 1.65;
      font-weight: 600;
      font-style: italic;
    }

    /* ── SECTION LABEL ── */
    .section-label {
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--gold);
      margin-bottom: 0.4rem;
    }

    .section-sub {
      font-size: 0.88rem;
      color: rgba(255,255,255,0.5);
      font-weight: 600;
      margin-bottom: 1.4rem;
    }

    /* ── QUESTIONS LIST ── */
    .question-list {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      margin: 1.2rem 0;
    }

    .question-item {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      padding: 1rem 1.2rem;
      transition: border-color 0.2s;
    }

    .question-item:hover { border-color: rgba(245,200,66,0.3); }

    .question-num {
      font-family: 'Playfair Display', serif;
      font-size: 1.4rem;
      font-weight: 900;
      color: var(--gold);
      opacity: 0.6;
      flex-shrink: 0;
      line-height: 1;
      margin-top: 0.1rem;
    }

    .question-text {
      font-size: 0.95rem;
      color: rgba(255,255,255,0.85);
      line-height: 1.6;
      font-weight: 600;
      font-style: italic;
    }

    /* ── PROMPT BOX ── */
    .prompt-card {
      background: rgba(20, 184, 166, 0.07);
      border: 1px solid rgba(20,184,166,0.25);
      border-left: 4px solid var(--teal);
      border-radius: 0 14px 14px 0;
      margin: 1.2rem 0;
      overflow: hidden;
    }

    .prompt-label {
      font-size: 0.72rem;
      font-weight: 900;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--teal);
      padding: 0.7rem 1.2rem 0.4rem;
    }

    .prompt-text {
      font-size: 0.88rem;
      color: rgba(255,255,255,0.82);
      line-height: 1.7;
      padding: 0 1.2rem 0.8rem;
      font-style: italic;
    }

    .copy-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0 1.2rem 1rem;
      padding: 0.5rem 1rem;
      background: rgba(20,184,166,0.15);
      border: 1.5px solid rgba(20,184,166,0.4);
      border-radius: 999px;
      color: var(--teal);
      font-size: 0.78rem;
      font-weight: 800;
      font-family: 'Nunito', sans-serif;
      cursor: pointer;
      transition: all 0.2s ease;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .copy-btn:hover {
      background: rgba(20,184,166,0.28);
      border-color: var(--teal);
      transform: translateY(-1px);
    }

    .copy-btn.copied {
      background: rgba(34,197,94,0.2);
      border-color: var(--green);
      color: var(--green);
    }

    /* ── TOOLS TABLE ── */
    .tools-grid {
      display: grid;
      gap: 0.8rem;
      margin: 1rem 0;
    }

    .tool-row {
      display: grid;
      grid-template-columns: 1.8fr 3fr 1.4fr;
      gap: 0;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 12px;
      overflow: hidden;
    }

    .tool-row.header {
      background: rgba(245,200,66,0.08);
      border-color: rgba(245,200,66,0.2);
    }

    .tool-cell {
      padding: 0.8rem 1rem;
      font-size: 0.85rem;
      color: rgba(255,255,255,0.75);
      font-weight: 600;
      border-right: 1px solid rgba(255,255,255,0.06);
      line-height: 1.5;
    }

    .tool-cell:last-child { border-right: none; }

    .tool-row.header .tool-cell {
      font-size: 0.72rem;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--gold);
    }

    .tool-name { font-weight: 800; color: var(--white); }

    .tool-url {
      color: var(--teal);
      text-decoration: none;
      font-weight: 700;
    }

    .tool-url:hover { color: var(--gold); }

    /* ── NEXT STEPS ── */
    .steps-grid {
      display: grid;
      gap: 1rem;
      margin: 1rem 0;
    }

    .step-row {
      display: flex;
      gap: 1.2rem;
      align-items: flex-start;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 16px;
      padding: 1.2rem 1.4rem;
      transition: border-color 0.2s;
    }

    .step-row:hover { border-color: rgba(245,200,66,0.25); }

    .step-num {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      font-weight: 900;
      color: var(--navy);
      flex-shrink: 0;
    }

    .step-content { flex: 1; }

    .step-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--white);
      margin-bottom: 0.3rem;
    }

    .step-desc {
      font-size: 0.88rem;
      color: rgba(255,255,255,0.65);
      line-height: 1.6;
    }

    /* ── EMBED WRAPPERS ── */
    .embed-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      z-index: 1;
      transition: opacity 0.5s ease;
      overflow: hidden;
    }

    .placeholder-green { background: linear-gradient(135deg, #08150a 0%, #0f2d12 100%); }
    .placeholder-red   { background: linear-gradient(135deg, #1a0808 0%, #2d0f0f 100%); }
    .placeholder-blue  { background: linear-gradient(135deg, #080d1a 0%, #0f1a2d 100%); }

    .placeholder-emoji {
      font-size: 3.5rem;
      animation: placeholderPulse 2s ease-in-out infinite;
    }

    .placeholder-text {
      font-size: 0.9rem;
      font-weight: 700;
      color: rgba(255,255,255,0.4);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .placeholder-shimmer {
      position: absolute;
      inset: 0;
      background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.03) 50%, transparent 60%);
      background-size: 200% 100%;
      animation: shimmer 2.5s infinite;
    }

    @keyframes placeholderPulse {
      0%, 100% { transform: scale(1); opacity: 0.7; }
      50% { transform: scale(1.08); opacity: 1; }
    }

    @keyframes shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    .video-wrapper, .game-wrapper, .book-wrapper {
      position: relative;
      height: 0;
      overflow: hidden;
    }

    .video-wrapper { padding-bottom: 56.25%; }
    .game-wrapper  { padding-bottom: 65%; }
    .book-wrapper  { padding-bottom: 62%; }

    .video-wrapper iframe,
    .game-wrapper iframe,
    .book-wrapper iframe {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      border: none;
      z-index: 2;
    }

    .spotify-wrapper { padding: 1.5rem; }
    .spotify-wrapper iframe { border-radius: 12px; width: 100%; border: none; }

    .spotify-note {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.35);
      text-align: center;
      margin-top: 0.8rem;
      font-weight: 600;
    }

    /* ── DEMO SECTION LABEL ── */
    .demo-intro {
      padding: 1.8rem 1.8rem 0;
    }

    .demo-intro p {
      font-size: 0.95rem;
      color: rgba(255,255,255,0.75);
      line-height: 1.7;
      margin-bottom: 0.8rem;
    }

    /* ── NOTE BOX ── */
    .note-box {
      background: rgba(59,130,246,0.08);
      border: 1px solid rgba(59,130,246,0.2);
      border-radius: 12px;
      padding: 1rem 1.2rem;
      font-size: 0.88rem;
      color: rgba(255,255,255,0.75);
      line-height: 1.65;
      margin: 1rem 0;
    }

    .note-box strong { color: #60a5fa; }

    /* ── TWO COL ── */
    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    /* ── CLOSING QUOTE ── */
    .closing-quote {
      text-align: center;
      padding: 3rem 2rem 2rem;
      border-top: 1px solid rgba(255,255,255,0.07);
    }

    .closing-quote p {
